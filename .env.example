# Frontend (build-time, must be prefixed with VITE_)
VITE_MAPBOX_TOKEN=pk.your_public_mapbox_token

# Backend (server-side, set in Vercel dashboard)
DIARY_PASSWORD=our-secret-love
SESSION_SECRET=replace-with-a-long-random-hex-string
SHEET_ID=your-google-sheet-id
# Paste the entire service-account JSON on one line (escape inner quotes as needed)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
